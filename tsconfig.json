{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "target": "es2020",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "dist-transpiled",
    "declarationDir": "dist/types",
    "removeComments": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
